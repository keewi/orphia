# ORPHEA Mobile App Environment Variables
# Copy to .env.local and fill in values

# Backend API URL (your Next.js web app)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Client IDs
# Create these in Google Cloud Console → APIs & Services → Credentials
# You need separate client IDs for web (Expo proxy), iOS, and Android
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
